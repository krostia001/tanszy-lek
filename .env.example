# Copy to .env and adjust if needed: `cp .env.example .env`
# Bun, Nuxt and Docker Compose read .env automatically.
# The project needs NO secrets. If one is ever added, it goes here, never into the code.

# Web server port (in Docker: the port published on your machine)
PORT=3000

# Path to the DuckDB database built by `bun run data`
NUXT_DUCKDB_PATH=data/app.duckdb

# Link to the public repository, shown in the site footer (optional)
NUXT_PUBLIC_REPO_URL=

# dane.gov.pl API base URL (public, no key required)
DANE_API_URL=https://api.dane.gov.pl/1.4

# Ministry of Health refund list (XLSX attachment of the newest "obwieszczenie").
# Leave empty to use the edition pinned in scripts/lib/sources.ts.
MZ_REFUND_XLSX_URL=
MZ_REFUND_EDITION=
